    f_crc16_dl3[10] = ^(d & 24'h7F7701) ^ 1'b1;
    f_crc16_dl3[11] = ^(d & 24'hBFBB00) ^ 1'b1;
    f_crc16_dl3[12] = ^(d & 24'hD2D088) ^ 1'b1;
    f_crc16_dl3[13] = ^(d & 24'h696844) ^ 1'b1;
    f_crc16_dl3[14] = ^(d & 24'h343422) ^ 1'b0;
    f_crc16_dl3[15] = ^(d & 24'h1A1A11) ^ 1'b0;
  end
endfunction
function [15:0] f_dllp_fld4;   // 4 bajta od FFFF (prvi bajt = najviši), polje {wire 4, wire 5}
  input [31:0] d;
  begin
    f_dllp_fld4[0] = ^(d & 32'hFCFEBB0B) ^ 1'b0;
    f_dllp_fld4[1] = ^(d & 32'hF8FD7717) ^ 1'b1;
