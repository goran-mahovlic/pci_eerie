    f_dllp_fld4[6] = ^(d & 32'hBB8BCBCC) ^ 1'b1;
    f_dllp_fld4[7] = ^(d & 32'h2D0D8D88) ^ 1'b0;
    f_dllp_fld4[8] = ^(d & 32'h5B1A1A11) ^ 1'b1;
    f_dllp_fld4[9] = ^(d & 32'hB6343422) ^ 1'b1;
    f_dllp_fld4[10] = ^(d & 32'h6D696844) ^ 1'b0;
    f_dllp_fld4[11] = ^(d & 32'hDAD2D088) ^ 1'b0;
    f_dllp_fld4[12] = ^(d & 32'hEFBFBB00) ^ 1'b1;
