# SPDX-License-Identifier: CERN-OHL-P-2.0
# ULX4M-LD + ULX4M-PCIe-IO (e6ccfde), pci_eerie open build (TASK-6160).
# DCU0 CH0 (TX W4/W5, RX Y5/Y6) i EXTREF0 (Y11/Y12) su fiksni — bez LOCATE-a.
BANK 0 VCCIO 3.3 V ;
BANK 1 VCCIO 3.3 V ;
BANK 6 VCCIO 3.3 V ;
BANK 7 VCCIO 3.3 V ;
SYSCONFIG CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON MCCLK_FREQ=62 SLAVE_SPI_PORT=DISABLE MASTER_SPI_PORT=ENABLE SLAVE_PARALLEL_PORT=DISABLE ;
LOCATE COMP "clk_25mhz" SITE "G2" ;
IOBUF PORT "clk_25mhz" PULLMODE=NONE IO_TYPE=LVCMOS33 ;
FREQUENCY PORT "clk_25mhz" 25 MHZ ;
LOCATE COMP "pcie_perst_n" SITE "D8" ;
IOBUF PORT "pcie_perst_n" IO_TYPE=LVCMOS33 PULLMODE=UP ;
LOCATE COMP "pcie_clkreq_n" SITE "A10" ;
IOBUF PORT "pcie_clkreq_n" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
LOCATE COMP "led[0]" SITE "A3" ;
LOCATE COMP "led[1]" SITE "B3" ;
LOCATE COMP "led[2]" SITE "B2" ;
LOCATE COMP "led[3]" SITE "C3" ;
LOCATE COMP "led[4]" SITE "C2" ;
LOCATE COMP "led[5]" SITE "C1" ;
LOCATE COMP "led[6]" SITE "D1" ;
LOCATE COMP "led[7]" SITE "D3" ;
IOBUF PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=4 ;
IOBUF PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=4 ;
IOBUF PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=4 ;
IOBUF PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=4 ;
IOBUF PORT "led[4]" IO_TYPE=LVCMOS33 DRIVE=4 ;
IOBUF PORT "led[5]" IO_TYPE=LVCMOS33 DRIVE=4 ;
IOBUF PORT "led[6]" IO_TYPE=LVCMOS33 DRIVE=4 ;
IOBUF PORT "led[7]" IO_TYPE=LVCMOS33 DRIVE=4 ;
# UART promatrača: isti redak na 5 kuglica, drugi znak retka = kuglica (a..e). N4 (ftdi_txd) ostaje ulaz.
LOCATE COMP "dbg_tx[0]" SITE "N3" ;
LOCATE COMP "dbg_tx[1]" SITE "P2" ;
LOCATE COMP "dbg_tx[2]" SITE "G1" ;
LOCATE COMP "dbg_tx[3]" SITE "B15" ;
LOCATE COMP "dbg_tx[4]" SITE "N1" ;
IOBUF PORT "dbg_tx[0]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 ;
IOBUF PORT "dbg_tx[1]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 ;
IOBUF PORT "dbg_tx[2]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 ;
IOBUF PORT "dbg_tx[3]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 ;
IOBUF PORT "dbg_tx[4]" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4 ;
# imena mreža nakon yosys spljoštavanja (top pclk/uclk se gube)
FREQUENCY NET "core.ep.core.eerie.rx_fifo.wr_clk" 125 MHZ ;
FREQUENCY NET "core.ep.core.eerie.rx_fifo.rd_clk" 62.5 MHZ ;
FREQUENCY NET "core.dbg.pclk" 125 MHZ ;
FREQUENCY NET "core.ep.app.clk" 62.5 MHZ ;
